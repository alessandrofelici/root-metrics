# Copy to .env (git-ignored). Docker Compose and `npm run dev` style shells read these.

# Shared secret the board sends as "Authorization: Bearer <token>" to POST /api/results.
# Unset: uploads are off (503). Make one with: openssl rand -hex 24
INGEST_TOKEN=

# Optional: keep results in Supabase instead of ./data/rootclock.db.
# Use the server-side secret key (sb_secret_...) or the legacy service_role key, never the
# publishable/anon key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Docker only: run the container as the owner of ./data (see README).
# UID=1000
# GID=1000
